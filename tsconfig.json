{
    "compilerOptions": {
        "target": "ES2018",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "@wordpress/element",
        "strict": false,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "@wordpress/*": [
                "../../node_modules/@wordpress/*/src"
            ]
        }
    },
    "include": [
        "blocks/**/src/**/*.tsx",
        "blocks/**/src/**/*.ts"
    ]
}