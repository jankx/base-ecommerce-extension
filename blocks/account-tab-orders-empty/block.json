{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jankx/account-tab-orders-empty",
  "title": "Orders Empty State",
  "category": "jankx",
  "icon": "clipboard",
  "description": "Notice shown in the My Account orders tab when the customer has no orders. Add any blocks inside and style the wrapper from the sidebar panel.",
  "textdomain": "base-ecommerce",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true,
      "gradients": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "textDecoration": true,
      "textTransform": true
    },
    "dimensions": {
      "minHeight": true
    },
    "__experimentalDefaultControls": {
      "color": "background",
      "spacing": "padding",
      "typography": "fontSize"
    }
  },
  "editorScript": "file:./build/index.js"
}
