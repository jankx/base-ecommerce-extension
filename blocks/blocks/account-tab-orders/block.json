{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jankx/account-tab-orders",
  "title": "Account Orders",
  "category": "jankx",
  "icon": "list-view",
  "description": "Lists the orders of the logged-in customer inside the My Account area.",
  "textdomain": "jankx",
  "attributes": {
    "jankxHideOnUltrawide": {
      "type": "boolean",
      "default": false
    },
    "jankxHideOnPc": {
      "type": "boolean",
      "default": false
    },
    "jankxHideOnTablet": {
      "type": "boolean",
      "default": false
    },
    "jankxHideOnMobile": {
      "type": "boolean",
      "default": false
    },
    "jankxFlexGrow": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./build/index.js"
}