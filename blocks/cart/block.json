{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jankx/cart",
  "title": "Shopping Cart",
  "category": "jankx",
  "icon": "cart",
  "description": "Shopping cart page. Lists the items in the customer's cart with totals and checkout action.",
  "textdomain": "jankx",
  "attributes": {
    "jankxHideOnUltrawide": {
      "type": "boolean",
      "default": false
    },
    "jankxHideOnPc": {
      "type": "boolean",
      "default": false
    },
    "jankxHideOnTablet": {
      "type": "boolean",
      "default": false
    },
    "jankxHideOnMobile": {
      "type": "boolean",
      "default": false
    },
    "jankxFlexGrow": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./build/index.js"
}