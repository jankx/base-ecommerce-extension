{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/checkout",
    "title": "Checkout",
    "category": "jankx",
    "icon": "money",
    "description": "Checkout page. Collects customer billing details and payment method, then turns the cart into an order.",
    "textdomain": "jankx",
    "attributes": {
        "jankxHideOnUltrawide": {
            "type": "boolean",
            "default": false
        },
        "jankxHideOnPc": {
            "type": "boolean",
            "default": false
        },
        "jankxHideOnTablet": {
            "type": "boolean",
            "default": false
        },
        "jankxHideOnMobile": {
            "type": "boolean",
            "default": false
        },
        "jankxFlexGrow": {
            "type": "boolean",
            "default": false
        }
    },
    "supports": {
        "html": false,
        "align": [
            "wide",
            "full"
        ],
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "editorScript": "file:./build/index.js"
}