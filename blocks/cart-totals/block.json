{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jankx/cart-totals",
  "title": "Cart Totals",
  "category": "jankx",
  "icon": "money-alt",
  "description": "Cart totals section with subtotal, discount, coupon form, total and checkout button.",
  "textdomain": "jankx",
  "attributes": {
    "jankxHideOnUltrawide": {
      "type": "boolean",
      "default": false
    },
    "jankxHideOnPc": {
      "type": "boolean",
      "default": false
    },
    "jankxHideOnTablet": {
      "type": "boolean",
      "default": false
    },
    "jankxHideOnMobile": {
      "type": "boolean",
      "default": false
    },
    "jankxFlexGrow": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./build/index.js"
}
