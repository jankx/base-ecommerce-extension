{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jankx/cart-item",
  "title": "Cart Item (Mini Cart)",
  "category": "jankx",
  "icon": "cart",
  "description": "Cart icon with item counter that opens a slide-out mini cart drawer.",
  "textdomain": "jankx",
  "attributes": {
    "jankxHideOnUltrawide": {
      "type": "boolean",
      "default": false
    },
    "jankxHideOnPc": {
      "type": "boolean",
      "default": false
    },
    "jankxHideOnTablet": {
      "type": "boolean",
      "default": false
    },
    "jankxHideOnMobile": {
      "type": "boolean",
      "default": false
    },
    "jankxFlexGrow": {
      "type": "boolean",
      "default": false
    },
    "badgeColor": {
      "type": "string"
    },
    "badgeBgColor": {
      "type": "string"
    },
    "badgeTop": {
      "type": "string"
    },
    "badgeRight": {
      "type": "string"
    },
    "badgeWidth": {
      "type": "string"
    },
    "badgeHeight": {
      "type": "string"
    },
    "badgePadding": {
      "type": "object"
    },
    "badgeMargin": {
      "type": "object"
    },
    "badgeFontSize": {
      "type": "string"
    },
    "badgeBorderWidth": {
      "type": "string"
    },
    "badgeBorderColor": {
      "type": "string"
    },
    "badgeBorderRadius": {
      "type": "string"
    }
  },
  "supports": {
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./build/index.js"
}