{
    "name": "jankx/base-ecommerce-extension",
    "description": "Jankx E-Commerce Base Extension: shared cart, checkout, payment, order + product type registry",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Jankx\\Extensions\\Ecommerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jankx\\Extensions\\Ecommerce\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Puleeno Nguyen",
            "email": "puleeno@gmail.com"
        }
    ],
    "require": {},
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.5"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}